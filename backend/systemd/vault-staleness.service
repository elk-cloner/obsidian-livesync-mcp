[Unit]
Description=Check that the Obsidian vault mirror is still being updated
Documentation=file://@BACKEND_DIR@/docs/runbook.md

[Service]
Type=oneshot
WorkingDirectory=@BACKEND_DIR@
ExecStart=@BACKEND_DIR@/scripts/bridge-staleness-check.sh
# A non-zero exit lands in the journal and marks the unit failed, which is what
# "systemctl --failed" and any journal-based alerting will pick up. No [Install]
# section on purpose: this unit is driven only by vault-staleness.timer.
