[Unit]
Description=One-way rclone backup of the Obsidian vault mirror to Google Drive
Documentation=file://@BACKEND_DIR@/docs/runbook.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@BACKEND_DIR@
ExecStart=/usr/bin/flock -n /run/vault-backup.lock @BACKEND_DIR@/scripts/vault-backup.sh
TimeoutStartSec=4h
# Backups must never compete with interactive work.
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
