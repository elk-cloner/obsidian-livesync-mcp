# ---------------------------------------------------------------------------
# Copy to .env, fill in, then `chmod 600 .env`. Never commit .env.
# ---------------------------------------------------------------------------

# Base domain. CouchDB is served at couch.$DOMAIN, the MCP server at mcp.$DOMAIN.
# Both need an A record pointing at this VPS before Caddy can issue certificates.
DOMAIN=example.com

# Email Caddy registers with Let's Encrypt for expiry notices.
ACME_EMAIL=you@example.com

# ---------------------------------------------------------------------------
# CouchDB
# ---------------------------------------------------------------------------
COUCHDB_USER=obsidian
# openssl rand -base64 32
COUCHDB_PASSWORD=

# ---------------------------------------------------------------------------
# Vaults
# ---------------------------------------------------------------------------
# Leave this empty. scripts/add-vault.sh and scripts/remove-vault.sh manage it:
# each vault gets a CouchDB database, a directory under /srv/vaults, a history
# repo, and a peer group in the bridge config. It ends up looking like
# VAULTS="work-notes journal reading-list".
VAULTS=

# ---------------------------------------------------------------------------
# LiveSync end-to-end encryption
# ---------------------------------------------------------------------------
# The passphrase every device uses. The bridge needs it to decrypt into plain
# files. LOSING THIS LOSES THE VAULTS -- store it in a password manager.
LIVESYNC_PASSPHRASE=
# Path obfuscation passphrase. Leave empty: it then defaults to
# LIVESYNC_PASSPHRASE, which is what the Setup URIs from add-vault.sh use.
# Set it only if your devices were configured with a different one.
LIVESYNC_OBFUSCATE_PASSPHRASE=

# ---------------------------------------------------------------------------
# MCP server (Google OAuth, see docs/setup.md)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The one Google account allowed to use the connector. Everything else is
# rejected even after a successful Google sign-in.
ALLOWED_EMAIL=you@gmail.com
# openssl rand -base64 48 -- must stay stable across restarts, or Claude's
# registered OAuth client is invalidated and the connector breaks.
JWT_SIGNING_KEY=
# python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
OAUTH_STORAGE_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Git history
# ---------------------------------------------------------------------------
# Every vault gets local history in /srv/git/<vault>.git, committed every 15
# minutes. Nothing to set up for that.
#
# Pushing that history to GitHub is optional and off by default. To turn it on:
# set GIT_PUSH=github, run `sudo gh auth login` once on the server, then re-run
# `sudo ./scripts/add-vault.sh <name>` for each existing vault. add-vault.sh
# creates one PRIVATE repo per vault (or reuses an existing one).
GIT_PUSH=
# Optional. The GitHub account or organization that holds the repos. Empty
# means the account `gh` is logged in as.
GIT_REMOTE_OWNER=
GIT_AUTHOR_NAME="vault-bot"
GIT_AUTHOR_EMAIL="vault-bot@example.com"

# ---------------------------------------------------------------------------
# Google Drive backup (rclone)
# ---------------------------------------------------------------------------
# The default off-server copy: a nightly one-way sync of every vault. Set up
# the remote once with `rclone config` (see docs/setup.md).
RCLONE_REMOTE=gdrive
RCLONE_BACKUP_PATH=ObsidianBackup
