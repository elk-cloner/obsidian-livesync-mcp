filters:
  and:
    - file.inFolder("projects/route-planner")
views:
  - type: table
    name: Open tasks
    filters:
      and:
        - type == "task"
        - status != "done"
    order: [file.name, kind, status, topics, due]
  - type: table
    name: Decisions
    filters:
      and:
        - type == "decision"
        - status == "active"
    order: [file.name, topics, created]
  - type: table
    name: Records
    filters:
      and:
        - type == "record"
    order: [date, file.name, kind]
